<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de copia para Android 12+ (API 31).

    Hoy no llegan a aplicarse porque allowBackup="false" desactiva la copia. Se
    dejan correctas por si alguien la reactiva, porque antes decian lo contrario
    de lo que parecian.

    El fallo era sutil: cloud-backup solo llevaba un exclude de sharedpref. Sin
    ningun include, Android da por incluido TODO lo demas, asi que filesDir (con
    las credenciales de Xtream en claro, los hashes de las cuentas web y los
    registros) se subia a la nube.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
